includes:
    - phpstan-baseline.neon

parameters:
    level: 0
    paths:
        - app/AppCache.php
        - app/AppKernel.php
        - src
    excludePaths:
        # Tests generated by sensio/generator-bundle, outside of the PHPUnit suite
        - src/Ladb/CoreBundle/Tests (?)
    tmpDir: tools/phpstan/var
