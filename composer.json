{
    "name": "lairdubois/lairdubois",
    "license": "AGPLv3",
    "type": "project",
    "description": "L'Air du Bois",
    "autoload": {
        "psr-4": {
            "": "src/"
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "ext-amqp": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-imagick": "*",
        "ext-exif": "*",
        "ext-json": "*",
        "ext-memcached": "*",
        "ext-libxml": "*",
        "ext-fileinfo": "*",
        "ext-gmp": "*",
        "ext-iconv": "*",

        "doctrine/dbal": "^4.5",
        "doctrine/orm": "^3.7",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/persistence": "^4.2",
        "incenteev/composer-parameter-handler": "^2.3",
        "symfony/monolog-bundle": "^4.1",
        "symfony/polyfill-apcu": "^1.0",
        "symfony/polyfill-php86": "^1.43",
        "symfony/amqp-messenger": "8.1.*",
        "symfony/asset": "8.1.*",
        "symfony/config": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/doctrine-bridge": "8.1.*",
        "symfony/error-handler": "8.1.*",
        "symfony/event-dispatcher": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/options-resolver": "8.1.*",
        "symfony/password-hasher": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-core": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/security-http": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/twig": "^3.30",
        "monolog/monolog": "^3.0",

        "doctrine/doctrine-migrations-bundle": "^4.0",
        "beberlei/doctrineextensions": "^1.5",

        "friendsofsymfony/elastica-bundle": "^7.2",
        "stof/doctrine-extensions-bundle": "^1.15",
        "gedmo/doctrine-extensions": "^3.22",
        "behat/transliterator": "1.3.0",
        "liip/imagine-bundle": "^2.18",
        "bentools/webpush-bundle": "^0.14",
        "symfony/mercure-bundle": "~0.6.1",
        "symfony/reprise": "^1.3",

        "facebook/graph-sdk": "~5.0",
        "willdurand/geocoder": "^5.0",
        "geocoder-php/google-maps-provider": "^4.8",
        "commerceguys/addressing": "^2.3.2",
        "twitter/bootstrap": "3.3.7",
        "uikit/uikit": "2.27.2",
        "afarkas/html5shiv": "3.7.3",
        "blueimp/jquery-file-upload": "10.14.0",
        "jublonet/codebird-php": "2.6.1",
        "emojione/emojione": "4.5.0",
        "eonasdan/bootstrap-datetimepicker": "4.17.47",
        "egulias/email-validator": "^4.0",
        "jmikola/geojson": "^1.0",
        "giggsey/libphonenumber-for-php": "^7.2",
        "cebe/markdown": "1.2.1",
        "stripe/stripe-php": "^7.27.3",
        "hashids/hashids": "^4.1",
        "dirkgroenen/pinterest-api-php": "^0.2.11",
        "biblys/isbn": "2.0.6",
        "jaybizzle/crawler-detect" :"1.*",
        "suin/php-rss-writer": "^1.6",
        "chrome-php/chrome": "^1.16",

        "components/jquery": "3.3.1",
        "components/jqueryui": "1.12.1",
        "components/masonry": "3.2.2"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "~8.4.1",
        "doctrine/data-fixtures": "^2.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/dom-crawler": "8.1.*",
        "symfony/finder": "8.1.*",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "conflict": {
        "symfony/cache": ">=8.2",
        "symfony/clock": ">=8.2",
        "symfony/monolog-bridge": ">=8.2",
        "symfony/process": ">=8.2",
        "symfony/property-info": ">=8.2",
        "symfony/string": ">=8.2",
        "symfony/twig-bridge": ">=8.2",
        "symfony/type-info": ">=8.2",
        "symfony/var-dumper": ">=8.2",
        "symfony/var-exporter": ">=8.2",
        "symfony/web-link": ">=8.2"
    },
    "replace": {
        "robloach/component-installer": "*"
    },
    "scripts": {
        "symfony-scripts": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "@php bin/console cache:clear --no-warmup",
            "@php bin/console assets:install --symlink --relative web"
        ],
        "post-install-cmd": [
            "@symfony-scripts",
            "Ladb\\CoreBundle\\Composer\\ScriptHandler::updateDirectoryStructure"
        ],
        "post-update-cmd": [
            "@symfony-scripts"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "composer/package-versions-deprecated": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": false,
            "robloach/component-installer": false
        },
        "bin-dir": "bin"
    },
    "extra": {
        "installer-types": ["component"],
        "installer-paths": {
            "vendor/{$vendor}/{$name}/": ["type:component"]
        },
        "incenteev-parameters": {
            "file": "app/config/parameters.yml",
            "env-map": {
                "database_host": "DATABASE_HOST",
                "database_password": "DATABASE_PASSWORD",
                "database_server_version": "DATABASE_SERVER_VERSION",
                "database_user": "DATABASE_USER",
                "elasticsearch_host": "ELASTICSEARCH_HOST",
                "mailer_dsn": "MAILER_DSN",
                "memcached_host": "MEMCACHED_HOST",
                "mercure_jwt_secret": "MERCURE_JWT_SECRET",
                "mercure_public_url": "MERCURE_PUBLIC_URL",
                "mercure_url": "MERCURE_URL",
                "rabbitmq_host": "RABBITMQ_HOST",
                "rabbitmq_password": "RABBITMQ_PASSWORD",
                "rabbitmq_user": "RABBITMQ_USER",
                "router_default_uri": "ROUTER_DEFAULT_URI"
            }
        }
    }
}
