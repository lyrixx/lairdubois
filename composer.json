{
    "name": "lairdubois/lairdubois",
    "license": "AGPLv3",
    "type": "project",
    "description": "L'Air du Bois",
    "autoload": {
        "psr-4": {
            "": "src/"
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-imagick": "*",
        "ext-exif": "*",
        "ext-json": "*",
        "ext-memcached": "*",
        "ext-libxml": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",

        "doctrine/orm": "^2.5",
        "doctrine/doctrine-bundle": "^1.6",
        "doctrine/doctrine-cache-bundle": "^1.2",
        "incenteev/composer-parameter-handler": "^2.0",
        "sensio/framework-extra-bundle": "^5.0.0",
        "symfony/monolog-bundle": "^3.1.0",
        "symfony/polyfill-apcu": "^1.0",
        "symfony/swiftmailer-bundle": "^3.5",
        "symfony/symfony": "4.4.*",
        "symfony/intl": "^4.4",
        "symfony/lock": "^4.4",
        "twig/twig": "^2.0",
        "monolog/monolog": "^1.0",

        "doctrine/doctrine-migrations-bundle": "^1.3.1",
        "beberlei/doctrineextensions": "^1.2",

        "friendsofsymfony/user-bundle": "*",
        "friendsofsymfony/elastica-bundle": "*",
        "stof/doctrine-extensions-bundle": "*",
        "liip/imagine-bundle": "~2.3",
        "gos/web-socket-bundle": "1.10.4",
        "bentools/webpush-bundle": "^0.7.1",
        "guzzlehttp/promises": "^1.5",
        "php-amqplib/rabbitmq-bundle": "^1.14",

        "facebook/graph-sdk": "~5.0",
        "willdurand/geocoder": "^4.6",
        "geocoder-php/google-maps-provider": "^4.8",
        "http-interop/http-factory-guzzle": "^1.2",
        "commerceguys/addressing": "^1.0",
        "twitter/bootstrap": "3.3.7",
        "uikit/uikit": "2.27.2",
        "afarkas/html5shiv": "3.7.3",
        "blueimp/jquery-file-upload": "10.14.0",
        "jublonet/codebird-php": "2.6.1",
        "emojione/emojione": "4.5.0",
        "eonasdan/bootstrap-datetimepicker": "4.17.47",
        "ps/image-optimizer": "1.2.0",
        "egulias/email-validator": "^2.1.10",
        "jmikola/geojson": "^1.0",
        "giggsey/libphonenumber-for-php": "^7.2",
        "cebe/markdown": "1.2.1",
        "stripe/stripe-php": "^7.27.3",
        "hashids/hashids": "^1.0",
        "dirkgroenen/pinterest-api-php": "^0.2.11",
        "biblys/isbn": "2.0.6",
        "jaybizzle/crawler-detect" :"1.*",
        "suin/php-rss-writer": "^1.6",
        "chrome-php/chrome": "^0.7.0",

        "components/jquery": "3.3.1",
        "components/jqueryui": "1.12.1",
        "components/masonry": "3.2.2"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^6.5",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "symfony/phpunit-bridge": "~3.0"
    },
    "replace": {
        "robloach/component-installer": "*"
    },
    "scripts": {
        "symfony-scripts": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "@php bin/console cache:clear --no-warmup",
            "@php bin/console assets:install --symlink --relative web"
        ],
        "post-install-cmd": [
            "@symfony-scripts",
            "Ladb\\CoreBundle\\Composer\\ScriptHandler::updateDirectoryStructure"
        ],
        "post-update-cmd": [
            "@symfony-scripts"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "composer/package-versions-deprecated": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": false,
            "robloach/component-installer": false
        },
        "bin-dir": "bin"
    },
    "extra": {
        "installer-types": ["component"],
        "installer-paths": {
            "vendor/{$vendor}/{$name}/": ["type:component"]
        },
        "incenteev-parameters": {
            "file": "app/config/parameters.yml",
            "env-map": {
                "database_host": "DATABASE_HOST",
                "database_password": "DATABASE_PASSWORD",
                "database_user": "DATABASE_USER",
                "elasticsearch_host": "ELASTICSEARCH_HOST",
                "memcached_host": "MEMCACHED_HOST",
                "rabbitmq_host": "RABBITMQ_HOST",
                "rabbitmq_password": "RABBITMQ_PASSWORD",
                "rabbitmq_user": "RABBITMQ_USER",
                "router.request_context.host": "ROUTER_REQUEST_CONTEXT_HOST",
                "websocket_host": "WEBSOCKET_HOST",
                "websocket_uri": "WEBSOCKET_URI"
            }
        }
    }
}
