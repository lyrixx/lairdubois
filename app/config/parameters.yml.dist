parameters:
    database_driver:                pdo_mysql
    database_host:                  localhost
    database_port:                  3306
    database_name:                  db_fr_lairdubois_www
    database_user:                  YOUR_DATABASE_USER
    database_password:              YOUR_DATABASE_PASSWORD
    database_path:                  null
    # The version of the database server ("10.11.19-MariaDB"), so that Doctrine knows its platform
    # without connecting (doctrine:database:create, before the database exists); null: it connects
    database_server_version:        null

    mailer_dsn:                     smtp://localhost:25

    elasticsearch_host:             localhost
    elasticsearch_port:             9200

    memcached_host:                 localhost
    memcached_port:                 11211

    mercure_url:                    http://127.0.0.1:3000/.well-known/mercure
    mercure_public_url:             https://www.lairdubois.fr/.well-known/mercure
    mercure_jwt_secret:             YOUR_MERCURE_JWT_SECRET

    rabbitmq_host:                  localhost
    rabbitmq_port:                  5672
    rabbitmq_user:                  YOUR_RABBITMQ_USER
    rabbitmq_password:              YOUR_RABBITMQ_PASSWORD
    rabbitmq_vhost:                 /

    locale:                         fr
    secret:                         THIS_TOKEN_IS_NOT_SECRET_CHANGE_IT
    admin_username:                 admin
    ga_tracking_id:                 YOUR_GOOGLE_ANALYTICS_TRACKING_CODE

    router.request_context.host:    www.lairdubois.fr
    router.request_context.scheme:  https

    chromium:                       /usr/bin/chromium

    google_api_key:                 YOUR_GOOGLE_API_KEY

    twitter_consumer_key:           YOUR_TWITTER_CONSUMER_KEY
    twitter_consumer_secret:        YOUR_TWITTER_CONSUMER_SECRET
    twitter_access_token:           YOUR_TWITTER_ACCESS_TOKEN
    twitter_access_secret:          YOUR_TWITTER_ACCESS_SECRET

    facebook_app_id:                YOUR_FACEBOOK_APP_ID
    facebook_app_secret:            YOUR_FACEBOOK_APP_SECRET
    facebook_page_id:               YOUR_FACEBOOK_PAGE_ID
    facebook_access_token:          YOUR_FACEBOOK_ACCESS_TOKEN

    pinterest_client_id:            YOUR_PINTEREST_CLIENT_ID
    pinterest_client_secret:        YOUR_PINTEREST_CLIENT_SECRET
    pinterest_access_token:         YOUR_PINTEREST_ACCESS_TOKEN

    mastodon_instance:              https://mastodon.social
    mastodon_access_token:          YOUR_MASTODON_ACCESS_TOKEN

    stripe_secret_key:              YOUR_STRIPE_SECRET_KEY
    stripe_publishable_key:         YOUR_STRIPE_PUBLISHABLE_KEY
    stripe_endpoint_secret:         YOUR_STRIPE_ENDPOINT_SECRET

    funding_min_amount_eur:         1
    funding_max_amount_eur:         250

    bentools_webpush.public_key:    YOUR_WEBPUSH_PUBLIC_KEY
    bentools_webpush.private_key:   YOUR_WEBPUSH_PRIVATE_KEY

