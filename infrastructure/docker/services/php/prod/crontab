# The crontab of docs/01-installation.md (step 13), run by supercronic in a container of the image
# "php" (SYMFONY_ENV=prod): keep in sync, castor qa:prod-smoke compares them. The times are those
# of Europe/Paris, as on the production server. The output of the commands goes to the log of the
# container.
CRON_TZ=Europe/Paris
0 4 * * 5 bin/console ladb:mailing:weeknews --force
0 * * * * bin/console ladb:cron:spotlight --force
*/2 * * * * bin/console ladb:cron:notification:populate --force
0 7,11,17,20 * * * bin/console ladb:cron:notification:email --force
0 3 * * * bin/console ladb:cron:sitemaps --force
*/5 * * * * bin/console ladb:cron:workflow:thumbnails --force
0 3 * * * bin/console ladb:cron:offers --force
*/5 * * * * bin/console ladb:cron:opencutlist:access:analyze --force
